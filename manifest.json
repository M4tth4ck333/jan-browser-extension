{
  "manifest_version": 3,
  "name": "Jan Summarizer",
  "version": "0.1.0",
  "description": "Summarize the current page using Jan Server, Cerebras, or any OpenAI-compatible endpoint.",
  "action": {
    "default_title": "Open Jan Summarizer"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "open_sidepanel": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Command+Shift+Y",
        "windows": "Ctrl+Shift+Y",
        "chromeos": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+Y"
      },
      "description": "Open Jan side panel"
    },
    "open_custom_prompt": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P",
        "windows": "Ctrl+Shift+P",
        "chromeos": "Ctrl+Shift+P",
        "linux": "Ctrl+Shift+P"
      },
      "description": "Open custom prompt input"
    }
    ,
    "toggle_autocomplete": {
      "suggested_key": {
        "default": "Alt+\\",
        "mac": "Command+Shift+\\",
        "windows": "Ctrl+Shift+\\",
        "chromeos": "Ctrl+Shift+\\",
        "linux": "Ctrl+Shift+\\"
      },
      "description": "Toggle Jan Autocomplete"
    }
  },
  "side_panel": {
    "default_path": "dist/ui/sidepanel/index.html"
  },
  "options_page": "dist/ui/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
