{
  "manifest_version": 3,
  "name": "Jan",
  "version": "0.12.17",
  "description": "The Jan companion for your browser: chat, inline writing help, search, and page context in the sidebar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jan-browser-extension@temp.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "action": {
    "default_title": "Open Jan",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://duckduckgo.com/*",
    "https://html.duckduckgo.com/*",
    "https://www.google.com/*",
    "https://google.com/*"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "commands": {
    "open_sidepanel": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Command+Shift+Y",
        "windows": "Ctrl+Shift+Y",
        "chromeos": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+Y"
      },
      "description": "Open Jan sidebar"
    },
    "open_custom_prompt": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P",
        "windows": "Ctrl+Shift+P",
        "chromeos": "Ctrl+Shift+P",
        "linux": "Ctrl+Shift+P"
      },
      "description": "Open custom prompt input"
    },
    "toggle_autocomplete": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Command+Shift+K",
        "windows": "Ctrl+Shift+K",
        "chromeos": "Ctrl+Shift+K",
        "linux": "Ctrl+Shift+K"
      },
      "description": "Toggle Jan Autocomplete"
    }
  },
  "sidebar_action": {
    "default_title": "Jan",
    "default_panel": "ui/sidepanel/index.html"
  },
  "options_page": "ui/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
