{
  "name": "jan-browser-extension",
  "version": "0.12.13",
  "description": "A Manifest V3 Chrome extension that summarizes the current page (or selected text) using any OpenAI-compatible API, including Cerebras and Jan Server.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:ext": "vite build --watch",
    "dev:mcp": "bash -lc 'cd mcp/search-server && if command -v bun >/dev/null 2>&1; then bun run dev; else npm run dev; fi'",
    "build:mcp": "bash scripts/build-mcp.sh",
    "start:mcp": "node mcp/search-server/dist/src/index.js",
    "dev:all": "concurrently -n ext,mcp -c blue,magenta \"npm run dev:ext\" \"npm run dev:mcp\"",
    "build:all": "npm run build && npm run build:mcp",
    "preview": "vite preview",
    "export:icons": "node scripts/export-icons.mjs",
    "release:local": "bash scripts/package-local.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@tailwindcss/vite": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.539.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-highlight": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "streamdown": "^1.1.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.6",
    "vite": "^7.1.2",
    "sharp": "^0.33.4"
  }
}
