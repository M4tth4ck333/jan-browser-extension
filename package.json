{
  "name": "jan-browser",
  "version": "0.14.1",
  "description": "Minimal browser extension that connects Jan's MCP tools to the active browser.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "make build-extension",
    "build:firefox": "make build-extension-firefox",
    "build:server": "make build-server",
    "build:web": "make build-web",
    "build:all": "make build-all",
    "dev:ui": "vite",
    "dev:mcp": "cd packages/mcp-server && npm run dev",
    "start:mcp": "node packages/mcp-server/dist/src/index.js",
    "clean": "make clean"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.246",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "tailwindcss": "3.4.17",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  }
}
